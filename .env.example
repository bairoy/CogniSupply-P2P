# Copy to .env and fill in. Never commit .env (it is gitignored).

# Host port is 5435 -- see docker-compose.yml. Developer machines commonly
# already run a native Postgres on 5432.
DATABASE_URL=postgresql://postgres:test@localhost:5435/inbound_test
# socket_timeout MUST exceed event_bus.consume()'s block time (5s), or every
# worker dies with "Timeout reading from socket" after 5 seconds idle:
# redis-py >=8 defaults socket_timeout to 5s, exactly the block duration.
REDIS_URL=redis://localhost:6379/0?socket_timeout=60

# Signs the JWTs that all three services verify (backend/shared/auth.py). It
# MUST be identical across yard/procurement/gateway or a token issued by the
# gateway will not verify on the other two. Unset falls back to a built-in dev
# secret and every service logs a warning at startup.
#   generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a sign-in lasts. A role change only takes effect at the user's next
# login, so this also bounds how stale a role can be.
JWT_TTL_HOURS=12

# Password given to every seeded demo account by seed.py. Local demo data only.
DEMO_PASSWORD=inbound2026

# The AI layer (shared/llm.py) runs on EITHER provider -- set one key. If
# neither is set, every AI call falls back to a deterministic stub and the API
# reports "ai_available": false: the system still runs end to end, it just
# stops being "intelligent".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider to use. Leave unset to auto-pick: Anthropic if its key is
# set, otherwise OpenAI. Set it to anthropic|openai to force one when both
# keys are present.
LLM_PROVIDER=
# Model overrides, per provider. Defaults: claude-opus-5 / gpt-5.4-mini.
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Where rendered invoice images are written (invoices.document_path).
INVOICE_DIR=./data/invoices

# --- frontend (VITE_-prefixed keys are the only ones bundled into the app) ---
# Mapbox GL JS public token (pk.*), used by the customer tracker in Track.tsx
# for the basemap and for road routing via the Directions API. Get one at
# https://account.mapbox.com/access-tokens/. Unset: the tracker renders a
# placeholder panel instead of the map -- everything else still works.
VITE_MAPBOX_TOKEN=

# Basemap for the tracker. Unset = mapbox://styles/mapbox/standard (GL JS v3's
# flagship style). Do NOT use light-v11: its ocean is hsl(220,1%,86%), so any
# coastal route renders against a dead grey slab. Verified alternatives:
#   mapbox://styles/mapbox/navigation-day-v1  - cleanest, built for routing
#   mapbox://styles/mapbox/streets-v12        - richest, full road network
VITE_MAPBOX_STYLE=